+bool initialize_renderer_smoke(renderer_smoke_state& state)
+{
+    u32 window_flags = SDL_WINDOW_OPENGL | SDL_WINDOW_RESIZABLE | SDL_WINDOW_ALLOW_HIGHDPI;
