+        gameInspection.setText("Папка читается · fsgame.ltx: " + yesNo(fsgame)
+                + " · gamedata: " + yesNo(gamedata)
+                + " · resources: " + yesNo(resources) + "\n" + hint
+                + ". Проверка информационная и не изменяет файлы.");
