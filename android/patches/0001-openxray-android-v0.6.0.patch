+
+    private String yesNo(boolean value) {
+        return value ? "есть" : "нет";
+    }
+
+    private void refreshRunningState() {
+        if (launchButton != null)
+            launchButton.setText(isEngineProcessRunning()
+                    ? "Вернуться в запущенную игру" : "Запустить игру");
