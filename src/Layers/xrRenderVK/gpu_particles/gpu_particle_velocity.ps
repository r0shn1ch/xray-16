#version 450

layout(location = 1) in vec2 uv;
layout(location = 3) in vec4 particle_color;
layout(location = 8) in vec4 previous_clip;
layout(location = 9) in vec4 current_clip;
layout(location = 10) flat in uint motion_valid;
layout(location = 0) out vec4 velocity;

layout(set = 0, binding = 0) uniform sampler2D diffuse;
layout(set = 1, binding = 5, std140) uniform DrawParams
{
    layout(offset = 68) float transparent_mode;
} draw_params;
layout(set = 1, binding = 6, std140) uniform MaterialParams
{
    layout(offset = 64) float alpha_ref;
    layout(offset = 128) vec4 base_u;
    layout(offset = 144) vec4 base_v;
} material;

void main()
{
    vec2 base_uv = vec2(dot(vec4(uv, 0.0, 1.0), material.base_u),
        dot(vec4(uv, 0.0, 1.0), material.base_v));
    if (texture(diffuse, base_uv).a * particle_color.a < material.alpha_ref) discard;
    float marker = draw_params.transparent_mode > 0.5 ? 2.0 + gl_FragCoord.z : 1.0;
    if (motion_valid == 0u || previous_clip.w <= 1e-6)
    {
        velocity = vec4(0.0, 0.0, -1.0, marker);
        return;
    }
    vec2 current_uv = current_clip.xy / current_clip.w * 0.5 + 0.5;
    vec2 previous_uv = previous_clip.xy / previous_clip.w * 0.5 + 0.5;
    velocity = vec4(previous_uv - current_uv, previous_clip.z / previous_clip.w, marker);
}
