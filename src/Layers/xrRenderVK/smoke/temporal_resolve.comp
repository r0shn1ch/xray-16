#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D current_color;
layout(set = 0, binding = 1) uniform sampler2D velocity_image;
layout(set = 0, binding = 2) uniform sampler2D previous_color;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D resolved_color;
layout(set = 0, binding = 4) uniform sampler2D current_depth;
layout(push_constant) uniform Parameters
{
    float history_weight;
    uint history_valid;
    uint reprojected_depth;
    float current_x, current_y, previous_x, previous_y;
} params;

float depth_at_source(ivec2 pixel, ivec2 input_size)
{
    ivec2 depth_size = textureSize(current_depth, 0);
    vec2 uv = (vec2(pixel) + 0.5) / vec2(input_size);
    ivec2 coord = clamp(ivec2(uv * vec2(depth_size)), ivec2(0), depth_size - 1);
    return texelFetch(current_depth, coord, 0).r;
}

vec3 current_at(ivec2 pixel, ivec2 extent, float target_depth)
{
    if ((params.reprojected_depth & 4u) == 0u)
        return texelFetch(current_color, pixel, 0).rgb;
    ivec2 input_size = textureSize(current_color, 0);
    vec2 uv = (vec2(pixel) + 0.5) / vec2(extent) + vec2(params.current_x, params.current_y);
    vec2 position = uv * vec2(input_size) - 0.5;
    ivec2 base = ivec2(floor(position));
    vec2 f = fract(position);
    ivec2 a = clamp(base, ivec2(0), input_size - 1);
    ivec2 b = clamp(base + ivec2(1, 0), ivec2(0), input_size - 1);
    ivec2 c = clamp(base + ivec2(0, 1), ivec2(0), input_size - 1);
    ivec2 d = clamp(base + ivec2(1, 1), ivec2(0), input_size - 1);
    vec4 weights = vec4((1.0 - f.x) * (1.0 - f.y), f.x * (1.0 - f.y),
        (1.0 - f.x) * f.y, f.x * f.y);
    float tolerance = max(0.001, 0.02 * target_depth);
    weights *= vec4(abs(depth_at_source(a, input_size) - target_depth) <= tolerance ? 1.0 : 0.0,
                    abs(depth_at_source(b, input_size) - target_depth) <= tolerance ? 1.0 : 0.0,
                    abs(depth_at_source(c, input_size) - target_depth) <= tolerance ? 1.0 : 0.0,
                    abs(depth_at_source(d, input_size) - target_depth) <= tolerance ? 1.0 : 0.0);
    float total = dot(weights, vec4(1.0));
    if (total <= 1e-5)
        return texelFetch(current_color, clamp(ivec2(uv * vec2(input_size)), ivec2(0), input_size - 1), 0).rgb;
    return (texelFetch(current_color, a, 0).rgb * weights.x + texelFetch(current_color, b, 0).rgb * weights.y +
            texelFetch(current_color, c, 0).rgb * weights.z + texelFetch(current_color, d, 0).rgb * weights.w) / total;
}

vec4 sample_history(vec2 uv, ivec2 extent, float expected_depth)
{
    vec2 position = uv * vec2(extent) - 0.5;
    ivec2 base = ivec2(floor(position));
    vec2 fraction = fract(position);
    vec4 a = texelFetch(previous_color, clamp(base, ivec2(0), extent - 1), 0);
    vec4 b = texelFetch(previous_color, clamp(base + ivec2(1, 0), ivec2(0), extent - 1), 0);
    vec4 c = texelFetch(previous_color, clamp(base + ivec2(0, 1), ivec2(0), extent - 1), 0);
    vec4 d = texelFetch(previous_color, clamp(base + ivec2(1, 1), ivec2(0), extent - 1), 0);
    vec4 weights = vec4((1.0 - fraction.x) * (1.0 - fraction.y), fraction.x * (1.0 - fraction.y),
        (1.0 - fraction.x) * fraction.y, fraction.x * fraction.y);
    float tolerance = max(0.001, 0.02 * expected_depth);
    weights *= vec4(abs(a.a - expected_depth) <= tolerance ? 1.0 : 0.0,
                    abs(b.a - expected_depth) <= tolerance ? 1.0 : 0.0,
                    abs(c.a - expected_depth) <= tolerance ? 1.0 : 0.0,
                    abs(d.a - expected_depth) <= tolerance ? 1.0 : 0.0);
    float total = dot(weights, vec4(1.0));
    return total > 1e-5 ? vec4((a.rgb * weights.x + b.rgb * weights.y +
        c.rgb * weights.z + d.rgb * weights.w) / total, total) : vec4(0.0);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(resolved_color);
    if (any(greaterThanEqual(pixel, extent))) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
    vec2 current_jitter = (params.reprojected_depth & 4u) != 0u ? vec2(params.current_x, params.current_y) : vec2(0.0);
    vec2 previous_jitter = (params.reprojected_depth & 4u) != 0u ? vec2(params.previous_x, params.previous_y) : vec2(0.0);
    vec2 input_uv = uv + current_jitter;
    ivec2 depth_extent = textureSize(current_depth, 0);
    ivec2 velocity_extent = textureSize(velocity_image, 0);
    ivec2 depth_pixel = clamp(ivec2(input_uv * vec2(depth_extent)), ivec2(0), depth_extent - 1);
    ivec2 velocity_pixel = clamp(ivec2(input_uv * vec2(velocity_extent)), ivec2(0), velocity_extent - 1);
    float depth = texelFetch(current_depth, depth_pixel, 0).r;
    vec4 velocity = texelFetch(velocity_image, velocity_pixel, 0);
    float history_depth = depth;
    if (velocity.w >= 2.0 && velocity.w <= 3.0)
        history_depth = velocity.w - 2.0;
    vec3 current = current_at(pixel, extent, depth);
    vec3 result = current;
    if (params.history_valid != 0)
    {
        vec2 motion = velocity.xy;
        vec2 reprojected_motion = motion + current_jitter - previous_jitter;
        vec2 previous_uv = uv + reprojected_motion;
        if (all(greaterThan(previous_uv, vec2(0.0))) &&
            all(lessThan(previous_uv, vec2(1.0))))
        {
            vec3 minimum_color = current;
            vec3 maximum_color = current;
            bool upscale = (params.reprojected_depth & 4u) != 0u;
            ivec2 color_extent = textureSize(current_color, 0);
            ivec2 source_center = clamp(ivec2(input_uv * vec2(color_extent)), ivec2(0), color_extent - 1);
            for (int y = -1; y <= 1; ++y)
                for (int x = -1; x <= 1; ++x)
                {
                    ivec2 neighbor = upscale ? clamp(source_center + ivec2(x, y), ivec2(0), color_extent - 1) :
                        clamp(pixel + ivec2(x, y), ivec2(0), extent - 1);
                    vec2 neighbor_uv = upscale ? (vec2(neighbor) + 0.5) / vec2(color_extent) :
                        (vec2(neighbor) + 0.5) / vec2(extent);
                    ivec2 neighbor_depth_pixel = clamp(ivec2(neighbor_uv * vec2(depth_extent)), ivec2(0), depth_extent - 1);
                    float neighbor_depth = texelFetch(current_depth, neighbor_depth_pixel, 0).r;
                    // Samples from a different surface cannot establish the
                    // color range of the current one at a depth silhouette.
                    if (abs(neighbor_depth - depth) > max(0.001, 0.02 * depth)) continue;
                    vec3 sample_color = texelFetch(current_color, neighbor, 0).rgb;
                    minimum_color = min(minimum_color, sample_color);
                    maximum_color = max(maximum_color, sample_color);
                }
            // Filter only taps on the reprojected surface; interpolating depth
            // before testing can mix foreground and background history.
            float expected_previous_depth = (params.reprojected_depth & 1u) != 0u ?
                velocity.z : depth;
            vec4 history = sample_history(previous_uv, extent, expected_previous_depth);
            // A sparse indirect sample may be black in every current neighbor
            // even when the underlying illumination is nonzero. Strict TAA
            // clipping then discards the entire history and prevents temporal
            // integration. Keep a bounded margin while depth rejection above
            // still prevents unrelated surfaces from contributing.
            if ((params.reprojected_depth & 2u) != 0u)
            {
                float scale = max(max(maximum_color.r, maximum_color.g), maximum_color.b);
                float margin = max(0.1, scale * 0.5);
                minimum_color = max(minimum_color - vec3(margin), vec3(0.0));
                maximum_color += vec3(margin);
            }
            vec3 history_color = clamp(history.rgb, minimum_color, maximum_color);
            float velocity_pixels = length(reprojected_motion * vec2(extent));
            float weight = clamp(params.history_weight, 0.0, 0.95) *
                (1.0 - smoothstep(2.0, 16.0, velocity_pixels));
            // Reject large color changes at nearly static pixels; motion vectors
            // do not yet cover every animated or transparent visual.
            float color_change = max(max(abs(current.r - history_color.r),
                abs(current.g - history_color.g)), abs(current.b - history_color.b));
            float static_pixel = 1.0 - smoothstep(0.0, 0.75, velocity_pixels);
            if ((params.reprojected_depth & 2u) == 0u)
                weight *= 1.0 - static_pixel * smoothstep(0.3, 0.7, color_change);
            // History alpha is the sum of taps passing the depth test above.
            if (expected_previous_depth < 0.0 || expected_previous_depth > 1.0 ||
                history.a <= 1e-5)
                weight = 0.0;
            result = mix(current, history_color, weight);
        }
    }
    imageStore(resolved_color, pixel, vec4(result, history_depth));
}
