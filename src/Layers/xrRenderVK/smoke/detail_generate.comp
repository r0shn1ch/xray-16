#version 450

struct Slot
{
    vec4 bounds;         // slot X, slot Z, Y base, Y height
    uvec4 data;          // world cell index, packed model IDs, triangle start, triangle count
    uvec4 palettes;      // one packed four-corner palette per model
};
struct Triangle { vec4 a; vec4 b; vec4 c; };
struct Placement { vec4 position_scale; float yaw; uint model; uvec2 padding; };
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Slots { Slot slots[]; };
layout(set = 0, binding = 1, std430) readonly buffer Ground { Triangle triangles[]; };
layout(set = 0, binding = 2, std430) readonly buffer Prototypes { vec2 scale_range[]; };
layout(set = 0, binding = 3, std430) writeonly buffer Placements { Placement output_placements[]; };
layout(set = 0, binding = 4, std430) readonly buffer Visible { uint visible_cells[]; };
layout(push_constant) uniform Generate
{
    uint slot_count;
    uint grid_size;
    float sample_spacing;
    float density;
    uint compact_cells;
} settings;

uint detail_random(uint value)
{
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    return value ^ (value >> 16u);
}

float triangle_height(Triangle triangle, vec2 position)
{
    vec2 edge1 = triangle.b.xz - triangle.a.xz;
    vec2 edge2 = triangle.c.xz - triangle.a.xz;
    float determinant = edge1.y * edge2.x - edge1.x * edge2.y;
    if (determinant < 1e-6)
        return -3.402823e38;
    // The ray points straight down. Test the projected triangle in XZ
    // and interpolate height only for an accepted hit.
    vec2 offset = position - triangle.a.xz;
    float u = offset.y * edge2.x - offset.x * edge2.y;
    float v = offset.x * edge1.y - offset.y * edge1.x;
    if (min(u, v) < 0.0 || u + v > determinant)
        return -3.402823e38;
    return triangle.a.y + dot(vec2(u, v) / determinant, vec2(triangle.b.y, triangle.c.y) - triangle.a.yy);
}

void main()
{
    uint group = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    if (group > 0xffffffffu / gl_WorkGroupSize.x)
        return;
    uint index = group * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    uint candidates_per_slot = settings.grid_size * settings.grid_size;
    if (candidates_per_slot == 0u || index >= output_placements.length())
        return;
    uint slot_index = index / candidates_per_slot;
    if (slot_index >= settings.slot_count || slot_index >= slots.length())
        return;
    if (settings.compact_cells != 0u)
    {
        if (slot_index >= visible_cells[0] || slot_index + 1u >= visible_cells.length()) return;
        slot_index = visible_cells[1u + slot_index];
        if (slot_index >= settings.slot_count || slot_index >= slots.length()) return;
    }
    output_placements[index] = Placement(vec4(0.0), 0.0, 0xffffffffu, uvec2(0u));

    Slot slot = slots[slot_index];
    uint candidate = index % candidates_per_slot;
    uint seed = detail_random(slot.data.x ^ (candidate * 0x9e3779b9u));
    vec2 grid = vec2(candidate % settings.grid_size, candidate / settings.grid_size) + .5;
    vec2 uv = grid / float(settings.grid_size);
    vec4 weights = vec4(0.0);
    for (uint model = 0u; model < 4u; ++model)
    {
        uint id = (slot.data.y >> (8u * model)) & 255u;
        if (id == 63u)
            continue;
        uint packed = slot.palettes[model];
        vec4 palette = vec4(uvec4(packed, packed >> 8u, packed >> 16u, packed >> 24u) & 255u);
        weights[model] = mix(mix(palette.x, palette.y, uv.x), mix(palette.z, palette.w, uv.x), uv.y);
    }
    float sum = dot(weights, vec4(1.0));
    // Match CPU placement for cells that also contain transparent details.
    float probability = settings.density * min(1.0, sum / 15.0);
    if (sum <= 0.0 || float(seed & 255u) / 255.0 > probability)
        return;
    float choice = float((seed >> 8u) & 65535u) / 65536.0 * sum;
    uint model = 0u;
    for (; model < 3u && choice >= weights[model]; ++model)
        choice -= weights[model];
    uint id = (slot.data.y >> (8u * model)) & 255u;
    if (id >= 63u || id >= scale_range.length())
        return;

    vec2 jitter = vec2(uvec2(seed >> 16u, seed >> 20u) & 15u) / 16.0 - .5;
    vec2 position = slot.bounds.xy + (grid + jitter * .5) * settings.sample_spacing;
    float ground = slot.bounds.z - 5.0;
    uint first = min(slot.data.z, uint(triangles.length()));
    uint count = min(slot.data.w, uint(triangles.length()) - first);
    for (uint triangle = 0u; triangle < count; ++triangle)
    {
        float height = triangle_height(triangles[first + triangle], position);
        if (height >= slot.bounds.z && height <= slot.bounds.z + slot.bounds.w + .1)
            ground = max(ground, height);
    }
    if (ground < slot.bounds.z)
        return;
    vec2 range = scale_range[id];
    float scale = mix(range.x, range.y, float(seed >> 24u) / 255.0);
    float yaw = float(seed & 65535u) * (6.2831853 / 65536.0);
    output_placements[index] = Placement(vec4(position.x, ground, position.y, scale), yaw, id, uvec2(0u));
}
