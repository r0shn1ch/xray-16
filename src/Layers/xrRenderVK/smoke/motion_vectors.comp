#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D scene_depth;
#ifdef XRAY_MOTION_RGBA
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D velocity;
#else
layout(set = 0, binding = 1, rg16f) uniform writeonly image2D velocity;
#endif
layout(push_constant) uniform Matrices
{
    mat4 inverse_view_projection;
    mat4 previous_view_projection;
} camera;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(velocity);
    if (any(greaterThanEqual(pixel, size))) return;
    float depth = texelFetch(scene_depth, pixel, 0).r;
    // This renderer uses ordinary depth: 1 is the cleared far plane.
    if (depth >= 1.0)
    {
        imageStore(velocity, pixel, vec4(0.0, 0.0, 1.0, 0.0));
        return;
    }
    vec2 current_uv = (vec2(pixel) + 0.5) / vec2(size);
    vec4 clip = vec4(current_uv.x * 2.0 - 1.0, 1.0 - current_uv.y * 2.0, depth, 1.0);
    vec4 world = camera.inverse_view_projection * clip;
    if (abs(world.w) < 1e-6)
    {
        imageStore(velocity, pixel, vec4(0.0, 0.0, -1.0, 0.0));
        return;
    }
    vec4 previous = camera.previous_view_projection * vec4(world.xyz / world.w, 1.0);
    if (previous.w <= 1e-6)
    {
        imageStore(velocity, pixel, vec4(0.0, 0.0, -1.0, 0.0));
        return;
    }
    vec2 previous_ndc = previous.xy / previous.w;
    vec2 previous_uv = vec2(previous_ndc.x * 0.5 + 0.5, 0.5 - previous_ndc.y * 0.5);
    imageStore(velocity, pixel, vec4(previous_uv - current_uv, previous.z / previous.w, 0.0));
}
