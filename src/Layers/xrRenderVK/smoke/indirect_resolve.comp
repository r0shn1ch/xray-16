#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, std430) readonly buffer Radiance { vec4 values[]; };
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D indirect_image;
void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(indirect_image);
    if (any(greaterThanEqual(pixel, size))) return;
    imageStore(indirect_image, pixel, values[uint(pixel.y * size.x + pixel.x)]);
}
