#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#include "visibility_common.glsl"
#include "visibility_geometry.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform usampler2D visibilityImage;
layout(set = 1, binding = 0) uniform sampler2D baseColorTextures[];
layout(rgba16f, binding = 5) writeonly uniform image2D baseColorImage;
layout(rgba16f, binding = 6) writeonly uniform image2D normalImage;
layout(rgba16f, binding = 7) writeonly uniform image2D surfaceImage;
layout(push_constant) uniform ResolveParameters
{
    mat4 viewProjection;
    vec2 origin;
    vec2 extent;
    uint firstDraw;
    uint drawCount;
    uint materialCount;
    uint geometryBatch;
    vec4 eyeAndSteep;
} parameters;

vec3 finiteNormal(vec3 normal)
{
    float squaredLength = dot(normal, normal);
    return squaredLength > 1e-12 && squaredLength < 1e20
        ? normal * inversesqrt(squaredLength) : vec3(0.0, 1.0, 0.0);
}

vec3 finiteTangentNormal(vec3 normal)
{
    float squaredLength = dot(normal, normal);
    return squaredLength > 1e-12 && squaredLength < 1e20
        ? normal * inversesqrt(squaredLength) : vec3(0.0, 0.0, 1.0);
}

bool finiteUv(vec2 value)
{
    return !any(isnan(value)) && !any(isinf(value));
}

vec3 finiteDirection(vec3 value, vec3 fallback)
{
    float squaredLength = dot(value, value);
    return squaredLength > 1e-12 && squaredLength < 1e20 ? value * inversesqrt(squaredLength) : fallback;
}

vec2 parallaxUv(vec2 uv, vec2 dx, vec2 dy, uint slot, float heightScale,
    vec3 position, vec3 geometric, vec3 inputTangent, vec3 inputBitangent)
{
    vec3 tangent = finiteDirection(inputTangent - geometric * dot(geometric, inputTangent), vec3(1, 0, 0));
    vec3 bitangent = finiteDirection(inputBitangent - geometric * dot(geometric, inputBitangent) -
        tangent * dot(tangent, inputBitangent), vec3(0, 0, 1));
    vec3 view = finiteDirection(parameters.eyeAndSteep.xyz - position, geometric);
    vec3 tangentView = vec3(dot(view, tangent), dot(view, bitangent), dot(view, geometric));
    float scale = max(heightScale, 0.0) * (1.0 - smoothstep(32.0, 96.0, length(parameters.eyeAndSteep.xyz - position)));
    if (parameters.eyeAndSteep.w < 0.5)
    {
        float height = textureGrad(baseColorTextures[nonuniformEXT(slot)], uv, dx, dy).r;
        return uv + finiteDirection(tangentView, vec3(0, 0, 1)).xy * (height - 0.5) * scale;
    }
    if (scale <= 1e-5) return uv;
    int count = int(mix(16.0, 8.0, clamp(abs(tangentView.z), 0.0, 1.0)));
    float layer = 1.0 / float(count);
    vec2 stepUv = tangentView.xy / max(abs(tangentView.z), 0.15) * scale / float(count);
    vec2 current = uv;
    float currentDepth = 0.0;
    float sampledDepth = 1.0 - textureGrad(baseColorTextures[nonuniformEXT(slot)], current, dx, dy).r;
    for (int step = 0; step < 16 && step < count && currentDepth < sampledDepth; ++step)
    {
        current -= stepUv;
        currentDepth += layer;
        sampledDepth = 1.0 - textureGrad(baseColorTextures[nonuniformEXT(slot)], current, dx, dy).r;
    }
    if (currentDepth <= 0.0) return uv;
    vec2 previous = current + stepUv;
    float before = 1.0 - textureGrad(baseColorTextures[nonuniformEXT(slot)], previous, dx, dy).r - (currentDepth - layer);
    float after = sampledDepth - currentDepth;
    return mix(current, previous, clamp(after / max(after - before, 1e-5), 0.0, 1.0));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = textureSize(visibilityImage, 0);
    if (any(greaterThanEqual(pixel, extent)) || any(notEqual(extent, imageSize(baseColorImage))) ||
        any(notEqual(extent, imageSize(normalImage))) || any(notEqual(extent, imageSize(surfaceImage))))
        return;
    uint id = texelFetch(visibilityImage, pixel, 0).x;
    if (!visibilityIdValid(id) || visibilityEntry(id) >= uint(entries.length()))
        return;

    uint draw = visibilityEntry(id);
    if (draw < parameters.firstDraw || draw - parameters.firstDraw >= parameters.drawCount)
        return;
    DrawEntry entry = entries[draw];
    uvec3 vertexIndex;
    if (entry.geometryBatch != parameters.geometryBatch || entry.materialSlot >= parameters.materialCount ||
        !visibilityVertices(entry, visibilityTriangle(id), vertexIndex))
        return;
    PackedVertex a = vertices[vertexIndex.x];
    PackedVertex b = vertices[vertexIndex.y];
    PackedVertex c = vertices[vertexIndex.z];
    if (any(equal(parameters.extent, vec2(0.0))))
        return;
    vec2 ndcPerPixel = 2.0 / parameters.extent;
    vec2 ndc = (vec2(pixel) + 0.5 - parameters.origin) * ndcPerPixel - 1.0;
    VisibilityBarycentrics barycentrics;
    if (!resolveVisibilityBarycentrics(visibilityClipPosition(a, parameters.viewProjection),
        visibilityClipPosition(b, parameters.viewProjection), visibilityClipPosition(c, parameters.viewProjection),
        ndc, ndcPerPixel, barycentrics))
        return;

    mat3x2 texcoords = mat3x2(a.normalYZUv.zw, b.normalYZUv.zw, c.normalYZUv.zw);
    vec2 uv = texcoords * barycentrics.weights;
    vec2 uvDx = texcoords * barycentrics.dx;
    vec2 uvDy = texcoords * barycentrics.dy;
    if (!finiteUv(uv) || !finiteUv(uvDx) || !finiteUv(uvDy)) return;
    vec3 normalA = finiteNormal(visibilityNormal(a));
    vec3 normalB = finiteNormal(visibilityNormal(b));
    vec3 normalC = finiteNormal(visibilityNormal(c));
    vec3 normal = finiteNormal(mat3(normalA, normalB, normalC) * barycentrics.weights);
    vec3 tangent = mat3(unpackSnorm4x8(a.bakedBATangentBitangent.z).xyz,
        unpackSnorm4x8(b.bakedBATangentBitangent.z).xyz,
        unpackSnorm4x8(c.bakedBATangentBitangent.z).xyz) * barycentrics.weights;
    vec3 bitangent = mat3(unpackSnorm4x8(a.bakedBATangentBitangent.w).xyz,
        unpackSnorm4x8(b.bakedBATangentBitangent.w).xyz,
        unpackSnorm4x8(c.bakedBATangentBitangent.w).xyz) * barycentrics.weights;
    if (entry.parallaxSlot < parameters.materialCount)
    {
        vec3 position = mat3(a.positionNormalX.xyz, b.positionNormalX.xyz, c.positionNormalX.xyz) * barycentrics.weights;
        uv = parallaxUv(uv, uvDx, uvDy, entry.parallaxSlot, entry.bumpHeight, position, normal, tangent, bitangent);
        if (!finiteUv(uv)) return;
        // A fragment shader's implicit gradients follow the displaced UVs.
        // Re-evaluate the paired pixels of its 2x2 quad to choose matching mips.
        for (uint axis = 0u; axis < 2u; ++axis)
        {
            float direction = ((axis == 0u ? pixel.x : pixel.y) & 1) == 0 ? 1.0 : -1.0;
            vec2 neighborNdc = ndc + (axis == 0u ? vec2(direction * ndcPerPixel.x, 0.0) :
                vec2(0.0, direction * ndcPerPixel.y));
            VisibilityBarycentrics neighbor;
            if (!resolveVisibilityBarycentrics(visibilityClipPosition(a, parameters.viewProjection),
                visibilityClipPosition(b, parameters.viewProjection), visibilityClipPosition(c, parameters.viewProjection),
                neighborNdc, ndcPerPixel, neighbor)) continue;
            vec3 neighborNormal = finiteNormal(mat3(normalA, normalB, normalC) * neighbor.weights);
            vec3 neighborTangent = mat3(unpackSnorm4x8(a.bakedBATangentBitangent.z).xyz,
                unpackSnorm4x8(b.bakedBATangentBitangent.z).xyz,
                unpackSnorm4x8(c.bakedBATangentBitangent.z).xyz) * neighbor.weights;
            vec3 neighborBitangent = mat3(unpackSnorm4x8(a.bakedBATangentBitangent.w).xyz,
                unpackSnorm4x8(b.bakedBATangentBitangent.w).xyz,
                unpackSnorm4x8(c.bakedBATangentBitangent.w).xyz) * neighbor.weights;
            vec3 neighborPosition = mat3(a.positionNormalX.xyz, b.positionNormalX.xyz, c.positionNormalX.xyz) * neighbor.weights;
            vec2 neighborUv = parallaxUv(texcoords * neighbor.weights, texcoords * neighbor.dx, texcoords * neighbor.dy,
                entry.parallaxSlot, entry.bumpHeight, neighborPosition, neighborNormal, neighborTangent, neighborBitangent);
            if (finiteUv(neighborUv))
            {
                if (axis == 0u) uvDx = (neighborUv - uv) * direction;
                else uvDy = (neighborUv - uv) * direction;
            }
        }
    }
    vec4 color = textureGrad(baseColorTextures[nonuniformEXT(entry.materialSlot)], uv, uvDx, uvDy);
    float hemi = dot(clamp(0.5 + 0.5 * vec3(normalA.y, normalB.y, normalC.y), 0.0, 1.0), barycentrics.weights);
    float normalAlpha = 0.875 + 0.125 * clamp(hemi, 0.0, 1.0);
    float bakedHemi = 0.0;
    if (entry.lightmapSlot < parameters.materialCount)
    {
        mat3x2 lightmapUv = mat3x2(a.lightmapUvBakedRG.xy, b.lightmapUvBakedRG.xy, c.lightmapUvBakedRG.xy);
        vec2 bakedUv = lightmapUv * barycentrics.weights;
        vec2 bakedDx = lightmapUv * barycentrics.dx;
        vec2 bakedDy = lightmapUv * barycentrics.dy;
        if (finiteUv(bakedUv) && finiteUv(bakedDx) && finiteUv(bakedDy))
        {
            vec4 baked = textureGrad(baseColorTextures[nonuniformEXT(entry.lightmapSlot)],
                bakedUv, bakedDx, bakedDy);
            color.a = baked.g;
            bakedHemi = baked.a;
            normalAlpha = bakedHemi * 0.75;
        }
    }
    bool hasPbr = entry.pbrSlot < parameters.materialCount || entry.metallicSlot < parameters.materialCount ||
        entry.roughnessSlot < parameters.materialCount || entry.aoSlot < parameters.materialCount;
    vec4 surface = vec4(0.0, entry.materialClass, 0.0, 0.0);
    bool hasBump = entry.bumpSlot < parameters.materialCount && entry.bumpAuxSlot < parameters.materialCount;
    bool hasNormal = entry.normalSlot < parameters.materialCount;
    if (hasBump || hasNormal)
    {
        vec3 mapped = vec3(0.0, 0.0, 1.0);
        if (hasBump)
        {
            vec4 bump = textureGrad(baseColorTextures[nonuniformEXT(entry.bumpSlot)], uv, uvDx, uvDy);
            vec4 aux = textureGrad(baseColorTextures[nonuniformEXT(entry.bumpAuxSlot)], uv, uvDx, uvDy);
            mapped = finiteTangentNormal(bump.wzy + aux.xyz - 1.0);
            surface.r = clamp(bump.r * bump.r, 0.0, 1.0);
            surface.a = aux.z * entry.bumpHeight;
        }
        if (hasNormal)
            mapped = finiteTangentNormal(textureGrad(baseColorTextures[nonuniformEXT(entry.normalSlot)],
                uv, uvDx, uvDy).xyz * 2.0 - 1.0);
        tangent -= normal * dot(normal, tangent);
        bitangent -= normal * dot(normal, bitangent);
        float t2 = dot(tangent, tangent), b2 = dot(bitangent, bitangent);
        float determinant = dot(cross(normal, tangent), bitangent);
        if (t2 > 1e-12 && b2 > 1e-12 && t2 < 1e20 && b2 < 1e20 &&
            determinant * determinant > t2 * b2 * 1e-6)
        {
            tangent *= inversesqrt(t2);
            bitangent = cross(normal, tangent) * (determinant < 0.0 ? -1.0 : 1.0);
            normal = finiteNormal(tangent * mapped.x + bitangent * mapped.y + normal * mapped.z);
        }
    }
    if (hasPbr)
    {
        vec3 pbr = vec3(0.0, 1.0, 1.0);
        if (entry.pbrSlot < parameters.materialCount)
            pbr = textureGrad(baseColorTextures[nonuniformEXT(entry.pbrSlot)], uv, uvDx, uvDy).rgb;
        if (entry.metallicSlot < parameters.materialCount)
            pbr.r = textureGrad(baseColorTextures[nonuniformEXT(entry.metallicSlot)], uv, uvDx, uvDy).r;
        if (entry.roughnessSlot < parameters.materialCount)
            pbr.g = textureGrad(baseColorTextures[nonuniformEXT(entry.roughnessSlot)], uv, uvDx, uvDy).r;
        if (entry.aoSlot < parameters.materialCount)
            pbr.b = textureGrad(baseColorTextures[nonuniformEXT(entry.aoSlot)], uv, uvDx, uvDy).r;
        surface = vec4(clamp(pbr.g, 0.0, 1.0), clamp(pbr.r, 0.0, 1.0), clamp(pbr.b, 0.0, 1.0), 0.0);
        normalAlpha = entry.lightmapSlot < parameters.materialCount
            ? 0.76 + 0.05 * clamp(bakedHemi, 0.0, 1.0) : 0.82 + 0.05 * clamp(hemi, 0.0, 1.0);
    }
    imageStore(baseColorImage, pixel, color);
    imageStore(normalImage, pixel, vec4(normal, normalAlpha));
    imageStore(surfaceImage, pixel, surface);
}
