#version 450
#extension GL_GOOGLE_include_directive : require
#ifdef VISIBILITY_ALPHA_TEST
#extension GL_EXT_nonuniform_qualifier : require
layout(set = 1, binding = 0) uniform sampler2D baseColorTextures[];
#endif
#include "visibility_common.glsl"
#include "visibility_geometry.glsl"

// Each workgroup handles one cluster. Rows process separate triangles and
// the lanes within a row traverse disjoint pixels of the triangle bounds.
layout(local_size_x = 16, local_size_y = 4) in;
layout(r32ui, binding = 0) uniform uimage2D visibilityImage;
layout(r32ui, binding = 4) uniform uimage2D depthBits;
struct IndexedCommand
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};
layout(std430, binding = 5) readonly buffer DrawCommands { IndexedCommand commands[]; };
layout(binding = 6) uniform usamplerBuffer drawMask;
layout(push_constant) uniform RasterParameters
{
    mat4 viewProjection;
    vec2 viewportOrigin;
    vec2 viewportExtent;
    uint firstDraw;
    uint drawCount;
    uint writeIds;
    uint geometryBatch;
    uint materialCount;
} parameters;

// Coordinates increase downwards. For positive-area triangles rasterize the
// left and top edges, so adjacent triangles don't both own the shared edge.
bool ownsEdge(vec2 a, vec2 b)
{
    return a.y > b.y || (a.y == b.y && a.x < b.x);
}

struct RasterEdge
{
    vec2 origin;
    vec2 segment;
    float direction;
};

RasterEdge makeRasterEdge(vec2 a, vec2 b)
{
    // Evaluate a shared edge from the same endpoint regardless of winding.
    if (a.y > b.y || (a.y == b.y && a.x > b.x))
        return RasterEdge(b, a - b, -1.0);
    return RasterEdge(a, b - a, 1.0);
}

float evaluateEdge(RasterEdge edge, vec2 samplePosition)
{
    vec2 offset = samplePosition - edge.origin;
    return (edge.segment.x * offset.y - edge.segment.y * offset.x) * edge.direction;
}

float clipDistance(vec4 vertex, uint plane)
{
    switch (plane)
    {
    case 0u: return vertex.w - 1e-7;
    case 1u: return vertex.z;
    case 2u: return vertex.w - vertex.z;
    case 3u: return vertex.w + vertex.x;
    case 4u: return vertex.w - vertex.x;
    case 5u: return vertex.w + vertex.y;
    default: return vertex.w - vertex.y;
    }
}

bool finiteClipPosition(vec4 vertex)
{
    return !any(isnan(vertex)) && !any(isinf(vertex));
}

void rasterizeTriangle(vec4 a, vec4 b, vec4 c, uint id, DrawEntry entry,
    vec4 originalA, vec4 originalB, vec4 originalC, mat3x2 texcoords)
{
    vec2 p0 = visibilityScreenPosition(a, parameters.viewportOrigin, parameters.viewportExtent);
    vec2 p1 = visibilityScreenPosition(b, parameters.viewportOrigin, parameters.viewportExtent);
    vec2 p2 = visibilityScreenPosition(c, parameters.viewportOrigin, parameters.viewportExtent);
    float area = visibilityEdge(p0, p1, p2);
    if (area == 0.0 || isnan(area) || isinf(area))
        return;
    if (area < 0.0)
    {
        vec2 point = p1;
        p1 = p2;
        p2 = point;
        vec4 vertex = b;
        b = c;
        c = vertex;
        area = -area;
    }
    ivec2 imageExtent = imageSize(depthBits);
    vec2 first = max(ceil(min(min(p0, p1), p2) - 0.5), vec2(0.0));
    vec2 last = min(floor(max(max(p0, p1), p2) - 0.5), vec2(imageExtent - 1));
    if (any(greaterThan(first, last)))
        return;
    bvec3 sharedEdge = bvec3(ownsEdge(p1, p2), ownsEdge(p2, p0), ownsEdge(p0, p1));
    RasterEdge edge0 = makeRasterEdge(p1, p2);
    RasterEdge edge1 = makeRasterEdge(p2, p0);
    RasterEdge edge2 = makeRasterEdge(p0, p1);
    vec3 depth = vec3(a.z, b.z, c.z) / vec3(a.w, b.w, c.w);
    vec2 depthDelta = depth.yz - depth.xx;
    for (int y = int(first.y); y <= int(last.y); ++y)
    {
        for (int x = int(first.x) + int(gl_LocalInvocationID.x); x <= int(last.x); x += int(gl_WorkGroupSize.x))
        {
            vec2 samplePosition = vec2(x, y) + 0.5;
            vec3 edges = vec3(evaluateEdge(edge0, samplePosition), evaluateEdge(edge1, samplePosition),
                evaluateEdge(edge2, samplePosition));
            if (any(lessThan(edges, vec3(0.0))) ||
                (edges.x == 0.0 && !sharedEdge.x) || (edges.y == 0.0 && !sharedEdge.y) ||
                (edges.z == 0.0 && !sharedEdge.z))
                continue;
#ifdef VISIBILITY_ALPHA_TEST
            if (entry.alphaCutoff >= 0.0)
            {
                if (entry.materialSlot >= parameters.materialCount) continue;
                vec2 ndcPerPixel = 2.0 / parameters.viewportExtent;
                vec2 ndc = (samplePosition - parameters.viewportOrigin) * ndcPerPixel - 1.0;
                VisibilityBarycentrics barycentrics;
                if (!resolveVisibilityBarycentrics(originalA, originalB, originalC, ndc, ndcPerPixel, barycentrics))
                    continue;
                vec2 uv = texcoords * barycentrics.weights;
                vec2 dx = texcoords * barycentrics.dx, dy = texcoords * barycentrics.dy;
                if (any(isnan(uv)) || any(isinf(uv)) || any(isnan(dx)) || any(isinf(dx)) ||
                    any(isnan(dy)) || any(isinf(dy))) continue;
                float alpha = textureGrad(baseColorTextures[nonuniformEXT(entry.materialSlot)], uv, dx, dy).a;
                if (alpha < entry.alphaCutoff) continue;
            }
#endif
            // Interpolate relative to one vertex to preserve constant depth
            // exactly, including at the near and far clip planes.
            float z = depth.x + dot(edges.yz / area, depthDelta);
            if (isnan(z) || isinf(z))
                continue;
            z = clamp(z, 0.0, 1.0);
            uint encodedDepth = z == 0.0 ? 0u : floatBitsToUint(z);
            ivec2 pixel = ivec2(x, y);
            // Dispatch all depth batches first. After a shader-write to
            // shader-read barrier, dispatch ID batches against the final depth.
            if (parameters.writeIds == 0u)
                imageAtomicMin(depthBits, pixel, encodedDepth);
            else if (imageLoad(depthBits, pixel).x == encodedDepth)
                imageAtomicMax(visibilityImage, pixel, id);
        }
    }
}

uint outsideFrustumPlanes(vec4 vertex)
{
    return (vertex.w < 1e-7 ? 1u : 0u) |
        (vertex.z < 0.0 ? 2u : 0u) |
        (vertex.z > vertex.w ? 4u : 0u) |
        (vertex.x < -vertex.w ? 8u : 0u) |
        (vertex.x > vertex.w ? 16u : 0u) |
        (vertex.y < -vertex.w ? 32u : 0u) |
        (vertex.y > vertex.w ? 64u : 0u);
}

void rasterizeDrawTriangle(DrawEntry entry, uint triangle, uint id)
{
    uvec3 verticesOfTriangle;
    if (!visibilityVertices(entry, triangle, verticesOfTriangle))
        return;
    vec4 polygon[10];
    polygon[0] = visibilityClipPosition(vertices[verticesOfTriangle.x], parameters.viewProjection);
    polygon[1] = visibilityClipPosition(vertices[verticesOfTriangle.y], parameters.viewProjection);
    polygon[2] = visibilityClipPosition(vertices[verticesOfTriangle.z], parameters.viewProjection);
    if (!finiteClipPosition(polygon[0]) || !finiteClipPosition(polygon[1]) ||
        !finiteClipPosition(polygon[2]))
        return;
    vec4 originalA = polygon[0], originalB = polygon[1], originalC = polygon[2];
    mat3x2 texcoords = mat3x2(vertices[verticesOfTriangle.x].normalYZUv.zw,
        vertices[verticesOfTriangle.y].normalYZUv.zw, vertices[verticesOfTriangle.z].normalYZUv.zw);
    uint outside0 = outsideFrustumPlanes(polygon[0]);
    uint outside1 = outsideFrustumPlanes(polygon[1]);
    uint outside2 = outsideFrustumPlanes(polygon[2]);
    if ((outside0 & outside1 & outside2) != 0u)
        return;
    uint planesToClip = outside0 | outside1 | outside2;
    if (planesToClip == 0u)
    {
        rasterizeTriangle(polygon[0], polygon[1], polygon[2], id, entry, originalA, originalB, originalC, texcoords);
        return;
    }
    uint vertexCount = 3u;
    // Each half-space can add one vertex to a convex polygon. Preserve the
    // original ID across the entire clipped fan for material interpolation.
    for (uint plane = 0u; plane < 7u; ++plane)
    {
        if ((planesToClip & (1u << plane)) == 0u)
            continue;
        vec4 clipped[10];
        uint clippedCount = 0u;
        vec4 previous = polygon[vertexCount - 1u];
        float previousDistance = clipDistance(previous, plane);
        for (uint i = 0u; i < vertexCount; ++i)
        {
            vec4 current = polygon[i];
            float currentDistance = clipDistance(current, plane);
            if ((previousDistance < 0.0 && currentDistance > 0.0) ||
                (previousDistance > 0.0 && currentDistance < 0.0))
            {
                // Evaluate from the inside endpoint in both edge directions.
                // Adjacent triangles then compute the same intersection.
                float insideDistance = max(previousDistance, currentDistance);
                float outsideDistance = min(previousDistance, currentDistance);
                vec4 inside = previousDistance > 0.0 ? previous : current;
                vec4 outside = previousDistance > 0.0 ? current : previous;
                clipped[clippedCount++] = mix(inside, outside, insideDistance / (insideDistance - outsideDistance));
            }
            if (currentDistance >= 0.0)
                clipped[clippedCount++] = current;
            previous = current;
            previousDistance = currentDistance;
        }
        if (clippedCount < 3u)
            return;
        vertexCount = clippedCount;
        for (uint i = 0u; i < vertexCount; ++i)
            polygon[i] = clipped[i];
    }
    for (uint i = 1u; i + 1u < vertexCount; ++i)
        rasterizeTriangle(polygon[0], polygon[i], polygon[i + 1u], id, entry, originalA, originalB, originalC, texcoords);
}

void main()
{
    if (any(notEqual(imageSize(depthBits), imageSize(visibilityImage))))
        return;
    uint draw = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint capacity = min(uint(commands.length()), uint(entries.length()));
    if (draw >= parameters.drawCount || parameters.firstDraw >= capacity || draw >= capacity - parameters.firstDraw)
        return;
    uint entryIndex = draw + parameters.firstDraw;
    uint wordIndex = entryIndex / 32u;
    if (wordIndex >= uint(textureSize(drawMask)) || (texelFetch(drawMask, int(wordIndex)).x &
        (1u << (entryIndex % 32u))) == 0u)
        return;
    IndexedCommand command = commands[entryIndex];
    DrawEntry entry = entries[entryIndex];
    if (entry.geometryBatch != parameters.geometryBatch || command.instanceCount == 0u ||
        command.firstIndex != entry.firstIndex || command.vertexOffset != entry.vertexOffset)
        return;
    uint triangleCount = min(min(command.indexCount, entry.indexCount) / 3u, visibilityTriangleMask + 1u);
    for (uint triangle = gl_LocalInvocationID.y; triangle < triangleCount; triangle += gl_WorkGroupSize.y)
        rasterizeDrawTriangle(entry, triangle, packVisibilityId(entryIndex, triangle));
}
