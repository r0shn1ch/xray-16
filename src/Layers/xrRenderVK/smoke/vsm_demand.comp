#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D depth_image;
layout(set = 0, binding = 1, std430) readonly buffer Parameters {
    mat4 inverse_view_projection;
    mat4 light_view;
    vec4 level[6];
    uvec4 settings; // axis, level count, sampling step, lod bias
    uvec4 kernel; // physical page size, reserved
} params;
layout(set = 0, binding = 2, std430) buffer Needed { uint pages[]; };

void request_page(uint level, uvec2 page, uint axis, uint flags)
{
    atomicOr(pages[(level * axis + page.y) * axis + page.x], flags);
}
void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy * params.settings.z);
    ivec2 extent = textureSize(depth_image, 0);
    if (any(greaterThanEqual(pixel, extent))) return;
    float depth = texelFetch(depth_image, pixel, 0).r;
    if (!(depth >= 0.0 && depth < 1.0)) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(extent);
    vec4 world = params.inverse_view_projection * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    if (abs(world.w) < 1e-8) return;
    vec2 light_xy = (params.light_view * vec4(world.xyz / world.w, 1.0)).xy;
    uint axis = params.settings.x, levels = params.settings.y;
    uint first = levels;
    for (uint i = 0u; i < levels; ++i)
    {
        vec2 coord = (light_xy - params.level[i].xy) / params.level[i].z;
        if (all(greaterThanEqual(coord, vec2(0.0))) && all(lessThan(coord, vec2(1.0))))
        { first = min(i + params.settings.w, levels - 1u); break; }
    }
    for (uint i = first; i < levels; ++i)
    {
        vec2 coord = (light_xy - params.level[i].xy) / params.level[i].z;
        if (!all(greaterThanEqual(coord, vec2(0.0))) || !all(lessThan(coord, vec2(1.0)))) continue;
        vec2 page_coord = coord * float(axis);
        uvec2 page = min(uvec2(page_coord), uvec2(axis - 1u));
        request_page(i, page, axis, 1u);
        if (params.kernel.x == 0u) continue;
        float size = float(params.kernel.x);
        vec2 local = (page_coord - vec2(page)) * size;
        ivec2 first_shift = -ivec2(lessThan(local, vec2(1.0)));
        ivec2 last_shift = ivec2(greaterThanEqual(local, vec2(size - 1.0)));
        for (int y = first_shift.y; y <= last_shift.y; ++y)
            for (int x = first_shift.x; x <= last_shift.x; ++x)
            {
                if (x == 0 && y == 0) continue;
                ivec2 neighbor = ivec2(page) + ivec2(x, y);
                if (all(greaterThanEqual(neighbor, ivec2(0))) && all(lessThan(neighbor, ivec2(axis))))
                    request_page(i, uvec2(neighbor), axis, 2u);
            }
    }
}
