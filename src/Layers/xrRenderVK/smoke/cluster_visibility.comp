#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct ClusterGroup
{
    vec4 bounds;
    float error;
    float padding0;
    float padding1;
    float padding2;
};

struct Cluster
{
    vec4 bounds;
    // refined group, owning group, first index, index count
    ivec4 data;
};

struct DrawIndexedIndirectCommand
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

layout(set = 0, binding = 0, std430) readonly buffer Groups
{
    ClusterGroup values[];
} groups;

layout(set = 0, binding = 1, std430) readonly buffer Clusters
{
    Cluster values[];
} clusters;

layout(set = 0, binding = 2, std430) writeonly buffer DrawCommands
{
    DrawIndexedIndirectCommand values[];
} commands;
layout(set = 0, binding = 3) uniform sampler2D previous_hiz;
layout(set = 0, binding = 4, std140) uniform PreviousViewProjection
{
    mat4 value;
} previous_view_projection;

layout(push_constant) uniform PushConstants
{
    mat4 mvp;
    vec4 cameraProjectionScale;
    // group first/count, cluster first/count
    uvec4 ranges;
    // output first, first index base, vertex base, reserved
    uvec4 draw;
    // target error bit pattern, chunk base, reserved
    uvec4 quality;
} pc;

float projectedError(ClusterGroup group)
{
    float error = group.error;
    if (isnan(error) || isinf(error) || error < 0.0)
        return 3.402823e+38;

    vec3 delta = group.bounds.xyz - pc.cameraProjectionScale.xyz;
    float distanceToBounds = max(length(delta) - max(group.bounds.w, 0.0), 0.05);
    return error * pc.cameraProjectionScale.w / distanceToBounds;
}

bool outsidePlane(float distance, vec3 normal, float radius)
{
    return distance < -radius * length(normal);
}

bool visible(vec4 sphere)
{
    if (any(isnan(sphere)) || any(isinf(sphere)) || sphere.w <= 0.0)
        return true;

    vec4 clip = pc.mvp * vec4(sphere.xyz, 1.0);
    vec3 rowX = vec3(pc.mvp[0][0], pc.mvp[1][0], pc.mvp[2][0]);
    vec3 rowY = vec3(pc.mvp[0][1], pc.mvp[1][1], pc.mvp[2][1]);
    vec3 rowZ = vec3(pc.mvp[0][2], pc.mvp[1][2], pc.mvp[2][2]);
    vec3 rowW = vec3(pc.mvp[0][3], pc.mvp[1][3], pc.mvp[2][3]);

    return !outsidePlane(clip.x + clip.w, rowX + rowW, sphere.w) &&
        !outsidePlane(clip.w - clip.x, rowW - rowX, sphere.w) &&
        !outsidePlane(clip.y + clip.w, rowY + rowW, sphere.w) &&
        !outsidePlane(clip.w - clip.y, rowW - rowY, sphere.w) &&
        !outsidePlane(clip.z, rowZ, sphere.w) &&
        !outsidePlane(clip.w - clip.z, rowW - rowZ, sphere.w);
}

float minimum_ratio(float value, float radius, float w_min, float w_max)
{
    return min(min((value - radius) / w_min, (value - radius) / w_max),
        min((value + radius) / w_min, (value + radius) / w_max));
}

float maximum_ratio(float value, float radius, float w_min, float w_max)
{
    return max(max((value - radius) / w_min, (value - radius) / w_max),
        max((value + radius) / w_min, (value + radius) / w_max));
}

bool projected_bounds(mat4 matrix, vec4 sphere, out vec2 minimum, out vec2 maximum,
    out vec2 center, out float nearest_depth)
{
    vec4 clip = matrix * vec4(sphere.xyz, 1.0);
    vec3 rowX = vec3(matrix[0][0], matrix[1][0], matrix[2][0]);
    vec3 rowY = vec3(matrix[0][1], matrix[1][1], matrix[2][1]);
    vec3 rowZ = vec3(matrix[0][2], matrix[1][2], matrix[2][2]);
    vec3 rowW = vec3(matrix[0][3], matrix[1][3], matrix[2][3]);
    float rx = sphere.w * length(rowX);
    float ry = sphere.w * length(rowY);
    float rz = sphere.w * length(rowZ);
    float rw = sphere.w * length(rowW);
    float w_min = clip.w - rw;
    float w_max = clip.w + rw;
    if (w_min <= 0.05 || isnan(w_min) || isinf(w_max)) return false;
    minimum = vec2(minimum_ratio(clip.x, rx, w_min, w_max),
        minimum_ratio(clip.y, ry, w_min, w_max));
    maximum = vec2(maximum_ratio(clip.x, rx, w_min, w_max),
        maximum_ratio(clip.y, ry, w_min, w_max));
    center = clip.xy / clip.w;
    nearest_depth = minimum_ratio(clip.z, rz, w_min, w_max);
    nearest_depth = clamp(nearest_depth, 0.0, 1.0);
    return !any(isnan(minimum)) && !any(isnan(maximum)) && !any(isinf(minimum)) &&
        !any(isinf(maximum)) && !any(isnan(center)) && !isnan(nearest_depth);
}

bool occludedByPreviousDepth(vec4 sphere)
{
    if (pc.quality.z == 0u || sphere.w <= 0.0) return false;
    vec2 previous_minimum, previous_maximum, previous_center;
    vec2 current_minimum, current_maximum, current_center;
    float previous_nearest, current_nearest;
    if (!projected_bounds(previous_view_projection.value, sphere,
            previous_minimum, previous_maximum, previous_center, previous_nearest) ||
        !projected_bounds(pc.mvp, sphere,
            current_minimum, current_maximum, current_center, current_nearest))
        return false;

    ivec2 base_size = textureSize(previous_hiz, 0);
    vec2 pixel_shift = abs((current_center - previous_center) * 0.5 * vec2(base_size));
    if (max(pixel_shift.x, pixel_shift.y) > 2.0 || abs(current_nearest - previous_nearest) > 0.005)
        return false;

    // Inflate the previous footprint to cover small camera motion and jitter.
    vec2 padding = 2.0 / vec2(base_size);
    vec2 uv_minimum = clamp(previous_minimum * 0.5 + 0.5 - padding, 0.0, 1.0);
    vec2 uv_maximum = clamp(previous_maximum * 0.5 + 0.5 + padding, 0.0, 1.0);
    vec2 pixel_extent = max((uv_maximum - uv_minimum) * vec2(base_size), vec2(1.0));
    int mip_count = textureQueryLevels(previous_hiz);
    int mip = int(clamp(floor(log2(max(pixel_extent.x, pixel_extent.y))),
        0.0, float(max(mip_count - 1, 0))));
    ivec2 mip_size = textureSize(previous_hiz, mip);
    ivec2 first = clamp(ivec2(floor(uv_minimum * vec2(mip_size))), ivec2(0), mip_size - 1);
    ivec2 last = clamp(ivec2(floor(max(uv_maximum * vec2(mip_size) - vec2(1e-4), vec2(0.0)))),
        ivec2(0), mip_size - 1);
    float farthest_occluder = max(
        max(texelFetch(previous_hiz, first, mip).r, texelFetch(previous_hiz, ivec2(last.x, first.y), mip).r),
        max(texelFetch(previous_hiz, ivec2(first.x, last.y), mip).r, texelFetch(previous_hiz, last, mip).r));
    if (farthest_occluder >= 0.99999) return false;
    return min(previous_nearest, current_nearest) > farthest_occluder + 0.002;
}

void main()
{
    uint localIndex = uint(gl_GlobalInvocationID.x) + pc.quality.y;
    if (localIndex >= pc.ranges.w)
        return;

    float targetErrorPixels = uintBitsToFloat(pc.quality.x);
    Cluster cluster = clusters.values[pc.ranges.z + localIndex];
    bool selected = true;
    if (cluster.data.y >= 0 && uint(cluster.data.y) < pc.ranges.y)
    {
        ClusterGroup owner = groups.values[pc.ranges.x + uint(cluster.data.y)];
        selected = projectedError(owner) > targetErrorPixels;
    }

    if (selected && cluster.data.x >= 0)
    {
        if (uint(cluster.data.x) >= pc.ranges.y)
            selected = true; // Malformed refinement metadata must not hide geometry.
        else
        {
            ClusterGroup refined = groups.values[pc.ranges.x + uint(cluster.data.x)];
            selected = projectedError(refined) <= targetErrorPixels;
        }
    }

    selected = selected && visible(cluster.bounds) && !occludedByPreviousDepth(cluster.bounds);
    DrawIndexedIndirectCommand command;
    command.indexCount = selected ? uint(max(cluster.data.w, 0)) : 0u;
    command.instanceCount = selected ? 1u : 0u;
    command.firstIndex = pc.draw.y + uint(max(cluster.data.z, 0));
    command.vertexOffset = int(pc.draw.z);
    command.firstInstance = 0u;
    commands.values[pc.draw.x + localIndex] = command;
}
