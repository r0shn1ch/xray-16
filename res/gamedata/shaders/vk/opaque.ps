struct Fragment
{
#if defined(VK_TRANSPARENT) && !defined(VK_UNLIT)
    float4 position : SV_Position;
#endif
    [[vk::location(0)]] float3 normal : TEXCOORD0;
    [[vk::location(1)]] float2 uv : TEXCOORD1;
#if defined(LEVEL_GEOMETRY)
    [[vk::location(2)]] float2 lightmap_uv : TEXCOORD2;
    [[vk::location(3)]] float4 baked : COLOR0;
#endif
    [[vk::location(4)]] float3 world_position : TEXCOORD4;
    [[vk::location(5)]] float hemi : TEXCOORD5;
    [[vk::location(6)]] float3 tangent : TEXCOORD6;
    [[vk::location(7)]] float3 bitangent : TEXCOORD7;
};


float2 matrix_uv(float2 uv, float4 row_u, float4 row_v)
{
    float4 coordinate = float4(uv, 0.0, 1.0);
    return float2(dot(coordinate, row_u), dot(coordinate, row_v));
}

uint surface_map_flags()
{
    return uint(max(surface_modes.z, 0.0) + 0.5);
}

bool has_surface_map(uint flag)
{
    return (surface_map_flags() & flag) != 0u;
}

float3 finite_normal(float3 value,float3 fallback)
{
    float length_squared=dot(value,value);
    return length_squared>1e-12 && length_squared<1e20 ? value*rsqrt(length_squared) : fallback;
}

float3 unpack_bump(float4 main_map, float4 auxiliary)
{
    float3 value = main_map.wzy + auxiliary.xyz - 1.0;
    float length_squared = dot(value, value);
    return length_squared > 1e-12 ? value * rsqrt(length_squared) : float3(0.0, 0.0, 1.0);
}

float3 model_surface_normal(Fragment fragment, float3 tangent_normal)
{
    float3 geometric = finite_normal(fragment.normal, float3(0, 1, 0));
    float3 tangent = fragment.tangent - geometric * dot(geometric, fragment.tangent);
    float3 bitangent = fragment.bitangent - geometric * dot(geometric, fragment.bitangent);
    float t2 = dot(tangent, tangent), b2 = dot(bitangent, bitangent);
    float determinant = dot(cross(geometric, tangent), bitangent);
    // Finite but collapsed authored frames are just as invalid as missing
    // frames. Preserve UV handedness and remove interpolation/scale skew.
    if (t2 > 1e-12 && b2 > 1e-12 && t2 < 1e20 && b2 < 1e20 &&
        determinant * determinant > t2 * b2 * 1e-6)
    {
        tangent *= rsqrt(t2);
        bitangent = cross(geometric, tangent) * (determinant < 0 ? -1.0 : 1.0);
        return finite_normal(tangent * tangent_normal.x + bitangent * tangent_normal.y +
            geometric * tangent_normal.z, geometric);
    }
    // Both level and model meshes repair their authored tangent basis on
    // upload. A remaining singular face has no stable normal-map orientation.
    return geometric;
}

float3 pbr_direct(float3 albedo, float metallic, float roughness,
    float3 normal, float3 view, float3 light)
{
    const float pi = 3.14159265358979323846;
    float nl = max(dot(normal, light), 0.0);
    float nv = max(dot(normal, view), 0.0);
    float3 half_vector = view + light;
    float half_length = length(half_vector);
    if (nl <= 0.0 || nv <= 0.0 || half_length < 1e-6) return 0.0;
    float3 h = half_vector / half_length;
    float nh = max(dot(normal, h), 0.0);
    float vh = max(dot(view, h), 0.0);
    roughness = clamp(roughness, 0.04, 1.0);
    metallic = saturate(metallic);
    float a = roughness * roughness;
    float a2 = a * a;
    float denominator = max(1.0 - nh * nh, 0.0) + nh * nh * a2;
    float distribution = a2 / max(pi * denominator * denominator, 1e-12);
    float k = (roughness + 1.0) * (roughness + 1.0) * 0.125;
    float geometry = nv / max(nv * (1.0 - k) + k, 1e-6) *
        nl / max(nl * (1.0 - k) + k, 1e-6);
    float3 f0 = lerp(float3(0.04, 0.04, 0.04), albedo, metallic);
    float3 fresnel = f0 + (1.0 - f0) * pow(1.0 - vh, 5.0);
    float3 specular = distribution * geometry * fresnel /
        (4.0 * max(nv, 0.001) * max(nl, 0.001));
    float3 diffuse = (1.0 - fresnel) * (1.0 - metallic) * albedo / pi;
    return (diffuse + specular) * nl;
}

float3 pbr_environment_brdf(float3 albedo, float metallic, float roughness, float ndotv)
{
    float3 f0 = lerp(float3(0.04, 0.04, 0.04), albedo, saturate(metallic));
    float4 r = clamp(roughness, 0.04, 1.0) * float4(-1.0, -0.0275, -0.572, 0.022) +
        float4(1.0, 0.0425, 1.04, -0.04);
    float a004 = min(r.x * r.x, exp2(-9.28 * saturate(ndotv))) * r.x + r.y;
    float2 ab = float2(-1.04, 1.04) * a004 + r.zw;
    return max(f0 * ab.x + ab.y, 0.0);
}

